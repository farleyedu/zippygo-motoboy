# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
dist-final/
dist-prod/
dist-test/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# Logs locais de verificação (não fazem parte do código)
/corrections-*.log
/integration-*.log
/android/build-*.log

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# EAS: nunca enviar caches nativos gerados no computador local.
google-services.json
firebase-admin*.json
/android/build/**
/android/app/build/**
/android/.gradle/**
/android/.cxx/**
/android/app/.cxx/**
/android/local.properties
/ios/build/**
/ios/Pods/**
/docs/**
# Configuração pública do cliente Firebase pode integrar o build, quando existir.
!google-services.json
